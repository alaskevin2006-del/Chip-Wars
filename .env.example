# Server only; never use VITE_ prefixes for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional legacy aliases: LLM_API_KEY, LLM_BASE_URL, LLM_MODEL_NAME
HOST=127.0.0.1
PORT=5001
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=2200
LLM_DAILY_LIMIT=60
# Set to unlimited to remove the daily cap; attempt counting and timeouts remain.
# Default ledger lives in ignored .runtime/diplomacy-quota.json
LLM_LEDGER_PATH=
PUBLIC_ORIGIN=
